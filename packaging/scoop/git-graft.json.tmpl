{
  "version": "{{VERSION}}",
  "description": "Copy-on-write Git workspaces for people and coding agents",
  "homepage": "{{HOMEPAGE}}",
  "license": "MIT",
  "depends": "git",
  "architecture": {
    "64bit": {
      "url": "{{RELEASE_URL}}/git-graft-{{VERSION}}-x86_64-pc-windows-msvc.zip",
      "hash": "{{SHA256:x86_64-pc-windows-msvc}}",
      "extract_dir": "git-graft-{{VERSION}}-x86_64-pc-windows-msvc"
    },
    "arm64": {
      "url": "{{RELEASE_URL}}/git-graft-{{VERSION}}-aarch64-pc-windows-msvc.zip",
      "hash": "{{SHA256:aarch64-pc-windows-msvc}}",
      "extract_dir": "git-graft-{{VERSION}}-aarch64-pc-windows-msvc"
    }
  },
  "bin": "git-graft.exe",
  "checkver": {
    "github": "{{HOMEPAGE}}"
  },
  "autoupdate": {
    "architecture": {
      "64bit": {
        "url": "{{HOMEPAGE}}/releases/download/v$version/git-graft-$version-x86_64-pc-windows-msvc.zip",
        "hash": {
          "url": "{{HOMEPAGE}}/releases/download/v$version/SHA256SUMS",
          "regex": "$sha256\\s+\\*?$basename"
        },
        "extract_dir": "git-graft-$version-x86_64-pc-windows-msvc"
      },
      "arm64": {
        "url": "{{HOMEPAGE}}/releases/download/v$version/git-graft-$version-aarch64-pc-windows-msvc.zip",
        "hash": {
          "url": "{{HOMEPAGE}}/releases/download/v$version/SHA256SUMS",
          "regex": "$sha256\\s+\\*?$basename"
        },
        "extract_dir": "git-graft-$version-aarch64-pc-windows-msvc"
      }
    }
  }
}
