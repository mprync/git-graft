class GitGraft < Formula
  desc "Faster, lighter replacement for git worktree, built for coding agents"
  homepage "{{HOMEPAGE}}"
  version "{{VERSION}}"
  license "MIT"

  on_macos do
    on_arm do
      url "{{RELEASE_URL}}/git-graft-{{VERSION}}-aarch64-apple-darwin.tar.gz"
      sha256 "{{SHA256:aarch64-apple-darwin}}"
    end
    on_intel do
      url "{{RELEASE_URL}}/git-graft-{{VERSION}}-x86_64-apple-darwin.tar.gz"
      sha256 "{{SHA256:x86_64-apple-darwin}}"
    end
  end

  on_linux do
    on_arm do
      url "{{RELEASE_URL}}/git-graft-{{VERSION}}-aarch64-unknown-linux-musl.tar.gz"
      sha256 "{{SHA256:aarch64-unknown-linux-musl}}"
    end
    on_intel do
      url "{{RELEASE_URL}}/git-graft-{{VERSION}}-x86_64-unknown-linux-musl.tar.gz"
      sha256 "{{SHA256:x86_64-unknown-linux-musl}}"
    end
  end

  # git-graft needs Git 2.46 or newer at runtime.
  depends_on "git"

  def install
    bin.install "git-graft"
    man1.install "git-graft.1"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/git-graft --version")
    # Git finds `git-graft` on PATH and runs it as `git graft`.
    ENV.prepend_path "PATH", bin
    assert_match version.to_s, shell_output("git graft --version")
  end
end
